<%- include("../partials/header", { title: "Mess Feedback" }) %>

<div class="card">
    <div class="card-header">
        <h1 class="card-title">Mess Feedback & Meal Ratings</h1>
        <a href="/admin/menu" class="btn btn-outline btn-sm">&larr; Manage Menu</a>
    </div>

    <!-- Feedback Alerts -->
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger">
            <%= error %>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success">
            <%= success %>
        </div>
    <% } %>

    <!-- Meal Type Average Rating Cards -->
    <div class="grid-2" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
        <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; text-align: center;">
            <h4 style="color: #64748b; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 0.4rem;">🍳 Breakfast</h4>
            <div style="font-size: 1.8rem; font-weight: 700; color: #1e3a8a;">
                ⭐ <%= averages.breakfast %>
            </div>
            <small style="color: #64748b;"><%= totals.breakfast.count %> review<%= totals.breakfast.count === 1 ? '' : 's' %></small>
        </div>

        <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; text-align: center;">
            <h4 style="color: #64748b; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 0.4rem;">🍛 Lunch</h4>
            <div style="font-size: 1.8rem; font-weight: 700; color: #1e3a8a;">
                ⭐ <%= averages.lunch %>
            </div>
            <small style="color: #64748b;"><%= totals.lunch.count %> review<%= totals.lunch.count === 1 ? '' : 's' %></small>
        </div>

        <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; text-align: center;">
            <h4 style="color: #64748b; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 0.4rem;">☕ Snacks</h4>
            <div style="font-size: 1.8rem; font-weight: 700; color: #1e3a8a;">
                ⭐ <%= averages.snacks %>
            </div>
            <small style="color: #64748b;"><%= totals.snacks.count %> review<%= totals.snacks.count === 1 ? '' : 's' %></small>
        </div>

        <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; text-align: center;">
            <h4 style="color: #64748b; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 0.4rem;">🍲 Dinner</h4>
            <div style="font-size: 1.8rem; font-weight: 700; color: #1e3a8a;">
                ⭐ <%= averages.dinner %>
            </div>
            <small style="color: #64748b;"><%= totals.dinner.count %> review<%= totals.dinner.count === 1 ? '' : 's' %></small>
        </div>
    </div>

    <!-- Student Reviews Table -->
    <h3 style="font-size: 1.15rem; color: #1e3a8a; margin-bottom: 0.75rem;">Recent Student Reviews</h3>
    <% if (feedbacks.length === 0) { %>
        <p style="color: #64748b; font-style: italic; padding: 2rem; text-align: center;">No student feedback submitted yet.</p>
    <% } else { %>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Day</th>
                        <th>Meal</th>
                        <th>Rating</th>
                        <th>Comment / Suggestions</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% feedbacks.forEach(fb => { %>
                        <tr>
                            <td>
                                <strong><%= fb.student ? fb.student.name : 'Anonymous' %></strong>
                                <br>
                                <small style="color: #64748b;"><%= fb.student ? fb.student.email : '' %></small>
                            </td>

                            <td><strong><%= fb.day %></strong></td>

                            <td>
                                <span class="badge" style="text-transform: capitalize; background-color: #f1f5f9; color: #334155; border: 1px solid #cbd5e1;">
                                    <%= fb.meal %>
                                </span>
                            </td>

                            <td>
                                <span style="font-weight: 600; color: <%= fb.rating >= 4 ? '#16a34a' : fb.rating === 3 ? '#d97706' : '#dc2626' %>;">
                                    ⭐ <%= fb.rating %> / 5
                                </span>
                            </td>

                            <td style="max-width: 320px;">
                                <p style="margin: 0; font-size: 0.9rem;"><%= fb.comment || '-' %></p>
                            </td>

                            <td style="white-space: nowrap; font-size: 0.85rem; color: #64748b;">
                                <%= new Date(fb.createdAt).toLocaleDateString() %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<%- include("../partials/footer") %>
